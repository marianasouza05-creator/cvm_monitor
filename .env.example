# Copie este arquivo para ".env" e preencha os valores.
# NUNCA versione o arquivo ".env" real (já está no .gitignore).

# Opcional: chave da API da Anthropic, usada apenas para gerar o resumo
# executivo do relatório (src/ai_summary.py). Se deixar em branco, o
# sistema funciona normalmente, só sem o resumo em linguagem natural.
ANTHROPIC_API_KEY=

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Opcional: aponta para um ZIP local em vez de baixar da CVM. Útil para
# testes offline ou para reprocessar um arquivo já baixado manualmente.
# Deixe em branco para usar a fonte oficial normalmente.
# CVM_CONSULTOR_ZIP_PATH=/caminho/para/cad_consultor_vlmob.zip
# CVM_ADM_CART_ZIP_PATH=/caminho/para/cad_adm_cart.zip